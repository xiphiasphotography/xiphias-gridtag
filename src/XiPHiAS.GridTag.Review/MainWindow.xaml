<Window x:Class="XiPHiAS.GridTag.Review.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XiPHiAS GridTag Review" Height="720" Width="1180" MinHeight="520" MinWidth="820">
    <Grid Margin="16" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Padding="12,8" Click="PreviousClick">Vorige</Button>
                <Button Padding="12,8" Margin="6,0" Click="NextClick">Volgende</Button>
                <Button x:Name="ManifestButton" Padding="12,8" Margin="0,0,6,0" Click="OpenManifestClick" IsEnabled="False">Kies manifest</Button>
                <Button Padding="12,8" Click="OpenResultsClick">Open results.json</Button>
            </StackPanel>
            <TextBlock Text="XiPHiAS GridTag Review" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <ComboBox x:Name="StatusFilter" SelectedIndex="0" SelectionChanged="FilterChanged">
                        <ComboBoxItem>Review en geen auto</ComboBoxItem>
                        <ComboBoxItem>Alleen review</ComboBoxItem>
                        <ComboBoxItem>Alleen geen auto</ComboBoxItem>
                    </ComboBox>
                    <TextBlock x:Name="SummaryText" Margin="0,8,0,0" TextWrapping="Wrap" Text="Open resultaten om te beginnen." />
                    <TextBlock x:Name="SourceText" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <ListBox x:Name="PhotoList" DisplayMemberPath="Display" SelectionChanged="PhotoSelectionChanged" />
            </DockPanel>
            <Border Grid.Column="2" BorderBrush="#D0D5DD" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="StatusText" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="ReasonText" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="CandidateText" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="PathText" Margin="0,6,0,12" TextWrapping="Wrap" Foreground="#667085" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#F2F4F7">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                            <TextBlock x:Name="PreviewText" Margin="20" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Open resultaten om foto's te bekijken." />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
